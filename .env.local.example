# Copy this file to .env.local and fill in the values from your Firebase
# project (Project settings -> General -> Your apps -> Web app config).
# These are public client identifiers, not secrets - access is controlled
# by firestore.rules / storage.rules instead.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Media and chat JSON are stored in Cloudinary (free tier, no card required)
# instead of Firebase Storage, since Cloud Storage for Firebase now requires
# the paid Blaze plan to enable at all. Get these from a free Cloudinary
# account: Dashboard -> Cloud Name, and Settings -> Upload -> an unsigned
# upload preset's name. See README.md for step-by-step instructions.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Media files larger than this (in MB) are skipped during upload instead of
# being uploaded, to stay comfortably within Cloudinary's free-tier quota.
NEXT_PUBLIC_MAX_MEDIA_MB=50
