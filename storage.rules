rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Each signed-in user can only read/write their own uploaded media
    // and parsed chat transcripts, stored under users/{uid}/threads/...
    match /users/{userId}/threads/{threadId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
